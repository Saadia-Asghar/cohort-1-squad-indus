# Set these in Vercel. Never commit a real value to this file.
# Local Postgres can also be supplied as DATABASE_USERNAME/PASSWORD/HOST/PORT/NAME
# (see D:\sweettooth app\.env). Those parts are mapped to DATABASE_URL on boot.
DATABASE_URL=postgresql://...
# Required in production (≥32 chars). Dev falls back to a local placeholder.
JWT_SECRET=replace-with-a-long-random-secret
# Required for /api/admin/login and the /admin portal. No defaults in code.
# Password must be at least 12 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional dedicated HMAC key for expiring customer action links. If omitted,
# JWT_SECRET is used. Use at least 32 random characters and keep it backend-only.
GUEST_ACTION_SECRET=
# Optional one-time pitch seed trigger for POST /api/admin/enrich-demo (Vercel only).
ENRICH_DEMO_SECRET=
# Never set on Vercel unless you intentionally wipe the DB.
# ALLOW_DESTRUCTIVE_SEED=1
# Optional Cloudinary (file uploads). Pasted https photo URLs work without this.
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Optional email for baker password-reset. Production needs one of these or bakers
# can still change a password from Settings while signed in.
# RESEND_API_KEY=re_...
# RESEND_FROM="Sweet Tooth Support <support@yourdomain.com>"
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Optional Clerk (Google SSO). When unset, native email/password auth is used.
# AUTH_MODE=clerk          — hybrid: Clerk + native JWT both work (recommended)
# AUTH_MODE=legacy         — native only, ignore Clerk on dashboard routes
# AUTH_MODE=clerk-only     — Clerk required; native register/login disabled
AUTH_MODE=legacy
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
FIREBASE_PROJECT_ID=baker-d9fb3

# Embeddings are local (384-dim) by default. 
# Set GEMINI_API_KEY to activate generative RAG responses using Gemini 1.5 Flash (free tier available at https://aistudio.google.com).
# Falls back to OPENAI_API_KEY (gpt-4o-mini) if configured.
# Falls back to raw text hints if neither is set.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional HTTPS hosts for pasted receipt URLs (Payments file upload works without this).
RECEIPT_IMAGE_HOSTS=res.cloudinary.com
# Self-host eng.traineddata.gz for deterministic production OCR.
TESSERACT_LANG_PATH=https://your-static-assets.example/tesseract

# Optional n8n automation bridge (order.created, chat.*, payment.advance_reminder,
# billing.upgrade_requested, billing.plan_activated).
# Create a Webhook trigger in n8n and put its URL here.
N8N_WEBHOOK_URL=https://your-n8n.example/webhook/indus-events
N8N_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Optional free Langfuse Hobby tracing — https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Platform subscription billing (free manual flow — no JazzCash API).
# Bakers transfer to your JazzCash/Easypaisa/bank, then WhatsApp you; you activate via POST /api/admin/activate-plan.
# You can also set runtime via POST /api/admin/platform-billing (Bearer admin JWT).
# Production: set real values on Vercel (do not commit them here).
PLATFORM_WHATSAPP=03001234567
PLATFORM_BILLING_NAME=Sweet Tooth
PLATFORM_PAYMENT_DETAILS=JazzCash 03XX-XXXXXXX (Name) · Easypaisa 03XX-XXXXXXX · Bank: XXXX IBAN PK...

# WhatsApp / Instagram (Meta Embedded Signup — complete via Agent Hub, not OAuth redirect).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
# Used to validate Meta's x-hub-signature-256 on inbound WhatsApp webhooks.
# META_APP_SECRET remains supported for existing Embedded Signup setups.
WHATSAPP_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
META_APP_ID=
META_CONFIG_ID=
TOKEN_ENCRYPTION_KEY=
